# LoadML training benchmark for the predbat-load-ml board (boards/predbat-load-ml/README.md).
#
#   coverage/load_ml_benchmark [--tracemalloc|--profile] <tree> <out dir>
#
# Runs Predbat from <tree>'s apps/predbat standalone with LoadML on and no saved model, in the memory benchmark's Linux
# container (no network, the wall clock frozen at the fixture's T0, BLAS pinned to 4 threads), and times LoadML's work
# up to and including its first initial training. Writes <out dir>/result.json (ok, training_seconds, peak_rss_mb,
# rss_after_mb, forecast_digest and more), forecast.json, modules.txt and predbat.log, and exits 0 when result.json was
# written.
#
# Only one run goes at a time on a machine: the run holds the lock at $LOAD_ML_BENCHMARK_LOCK from the image check to the
# end of its container, so wall time is never measured alongside another run. A caller that has to wait is told so, and
# result.json records queued_seconds. Other CPU-heavy work can take the same lock with
# python3 coverage/memory_benchmark_tools/bench_lock.py /tmp/predbat-load-ml-benchmark.lock -- <command>.
#
# --profile also writes <out dir>/profile.txt (cProfile over the LoadML ticks); --tracemalloc writes tracemalloc.txt.
# Either marks the result as profiled, and measure.py refuses it.
#
# Needs the local fixture, built by coverage/memory_benchmark_tools/export_fixture.py --load-ml into
# coverage/load_ml_benchmark_data (or $LOAD_ML_BENCHMARK_DATA). Builds the memory benchmark's pinned image on first use.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
TOOLS="$HERE/memory_benchmark_tools"
DATA="${LOAD_ML_BENCHMARK_DATA:-$HERE/load_ml_benchmark_data}"
LOCK="${LOAD_ML_BENCHMARK_LOCK:-/tmp/predbat-load-ml-benchmark.lock}"
CPUS="${LOAD_ML_BENCHMARK_CPUS:-4}"
MEMORY="${LOAD_ML_BENCHMARK_MEMORY:-3g}"
THREADS=4

ARGS=("$@")
TRACEMALLOC=""
DRIVER_ARGS=""
case "${1:-}" in
    --tracemalloc) TRACEMALLOC=1; shift ;;
    --profile) DRIVER_ARGS="--profile"; shift ;;
esac
if [ $# -ne 2 ]; then
    echo "usage: load_ml_benchmark [--tracemalloc|--profile] <tree> <out dir>"
    exit 2
fi
if [ ! -f "$1/apps/predbat/predbat.py" ]; then
    echo "Error: $1 is not a batpred checkout (no apps/predbat/predbat.py)"
    exit 2
fi
TREE="$(cd "$1" && pwd)"
if [ ! -f "$DATA/manifest.json" ]; then
    echo "Error: no LoadML benchmark fixture at $DATA (no manifest.json). Build it from the live Predbat add-on config with:"
    echo "  python3 coverage/memory_benchmark_tools/export_fixture.py --load-ml --days 28 --live <add-on config dir> --out coverage/load_ml_benchmark_data"
    exit 2
fi
# Everything from here on (the image build, the clean-up of an earlier run's container and the run itself) happens
# with the machine-wide lock held, so no other benchmark run's CPU load overlaps this one's
if [ -z "${LOAD_ML_BENCHMARK_LOCKED:-}" ]; then
    exec python3 "$TOOLS/bench_lock.py" "$LOCK" -- env LOAD_ML_BENCHMARK_LOCKED=1 bash "$0" "${ARGS[@]}"
fi
mkdir -p "$2"
OUT="$(cd "$2" && pwd)"
# Every output a run writes (the driver's, and the logs container_run.sh copies out), so a run that dies early never leaves
# an earlier run's figures, reports or log behind for the failure message below to point at
rm -f "$OUT/result.json" "$OUT/modules.txt" "$OUT/tracemalloc.txt" "$OUT/profile.txt" "$OUT/forecast.json" "$OUT/predbat.log" "$OUT/kernel_build.log"

# The frozen clock: the fixture's T0 in UTC, in the absolute form libfaketime freezes at (no "@", which would tick)
T0="$(python3 -c 'import json, sys; from datetime import datetime, timezone; t = datetime.fromisoformat(json.load(open(sys.argv[1]))["t0"]); print(t.astimezone(timezone.utc).strftime("%Y-%m-%d %H:%M:%S"))' "$DATA/manifest.json")"

# The memory benchmark's image, named after its Dockerfile and the tree's requirements
IMAGE="predbat-memory-bench:$(cat "$TOOLS/Dockerfile" "$TREE/requirements.txt" | shasum -a 256 | cut -c1-12)"
if ! docker image inspect "$IMAGE" > /dev/null 2>&1; then
    CONTEXT="$(mktemp -d)"
    cp "$TOOLS/Dockerfile" "$TREE/requirements.txt" "$CONTEXT/"
    docker build -q -t "$IMAGE" "$CONTEXT" > /dev/null
    rm -rf "$CONTEXT"
fi

# Every run starts from a fresh copy of the fixture (Predbat writes its database, cache and LoadML files), and reads a
# copy of the tree made for this run: Docker Desktop can serve a file edited after an earlier read at its old length
SCRATCH="$(mktemp -d)"
SOURCE="$(mktemp -d)"
trap 'rm -rf "$SCRATCH" "$SOURCE"' EXIT
cp -R "$DATA/." "$SCRATCH/"
rm -f "$SCRATCH/manifest.json"
cp -R "$TREE/apps/predbat/." "$SOURCE/"

# A run killed from outside (a worker over its time limit) releases the lock with its process, but docker run --rm
# leaves its container training; every run's container carries this label, so the next run kills any left over first
LABEL=predbat-load-ml-bench
LEFTOVER="$(docker ps -q --filter "label=$LABEL" 2> /dev/null || true)"
if [ -n "$LEFTOVER" ]; then
    echo "Killing a benchmark container left running by an earlier run: $LEFTOVER"
    # $LEFTOVER is unquoted on purpose: it may list several container ids
    docker kill $LEFTOVER > /dev/null 2>&1 || true
fi

set +e
# --init gives the container a real PID 1, so a signal sent to the run reaches it
docker run --rm --init --label "$LABEL" --network none --cpus "$CPUS" --memory "$MEMORY" \
    -e TZ=UTC -e BENCH_T0="$T0" -e BENCH_CYCLES=0 -e BENCH_TIMEOUT="${BENCH_TIMEOUT:-3600}" \
    -e BENCH_DRIVER=/bench/load_ml_driver.py -e BENCH_QUEUED_SECONDS \
    -e OPENBLAS_NUM_THREADS="$THREADS" -e OMP_NUM_THREADS="$THREADS" -e MKL_NUM_THREADS="$THREADS" \
    ${DRIVER_ARGS:+-e BENCH_DRIVER_ARGS="$DRIVER_ARGS"} ${TRACEMALLOC:+-e BENCH_TRACEMALLOC=1} \
    -v "$SOURCE:/src:ro" -v "$TOOLS:/bench:ro" -v "$SCRATCH:/fixture" -v "$OUT:/out" \
    "$IMAGE" bash /bench/container_run.sh
status=$?
set -e

if [ ! -f "$OUT/result.json" ]; then
    echo "Error: the run wrote no result.json (container exit $status); see $OUT/predbat.log and $OUT/kernel_build.log"
    exit 1
fi
exit 0
